{
  "_doc": "Shared by web/tests (Python) and, optionally, a Kotlin test. A case is the base layout with the top-level keys in 'merge' replaced (a null value removes the key), or the string 'raw' parsed as-is. 'expect' lists message fragments; every problem must contain one fragment from the list in order of appearance, and the count must equal expect's length. An empty list means valid.",
  "base": {
    "version": 1, "size": 50,
    "palette": { "g": 1, "path": 2, "in": 3 },
    "ground": "g",
    "floors": [ { "rect": [0, 0, 9, 9], "floor": "path" } ],
    "rooms": [ { "name": "A", "rect": [20, 20, 30, 30], "floor": "in", "wall": "w",
                 "doors": [ { "side": "west", "from": 24, "to": 26 } ] } ],
    "detail": [], "walls": [], "locs": [],
    "npcs": [ { "npc": "zeke", "x": 25, "z": 25 } ],
    "arrival": { "x": 5, "z": 5 }, "leavePortal": { "x": 6, "z": 6 }
  },
  "cases": [
    { "name": "base is valid", "merge": {}, "expect": [] },
    { "name": "not json", "raw": "{nope", "expect": ["not valid JSON"] },
    { "name": "wrong version", "merge": { "version": 2 }, "expect": ["version must be 1"] },
    { "name": "size too big", "merge": { "size": 200 }, "expect": ["size must be 8..128"] },
    { "name": "size too small", "merge": { "size": 4 }, "expect": ["size must be 8..128"] },
    { "name": "empty palette", "merge": { "palette": {} }, "expect": ["palette is empty", "ground: unknown floor 'g'", "floors[0].floor: unknown floor 'path'", "rooms[0].floor: unknown floor 'in'"] },
    { "name": "palette id out of range", "merge": { "palette": { "g": 1, "path": 2, "in": 999 } }, "expect": ["palette.in must be 0..173"] },
    { "name": "unknown ground", "merge": { "ground": "lava" }, "expect": ["ground: unknown floor 'lava'"] },
    { "name": "unknown floor in floors", "merge": { "floors": [ { "rect": [0, 0, 9, 9], "floor": "lava" } ] }, "expect": ["floors[0].floor: unknown floor 'lava'"] },
    { "name": "floor rect wrong shape", "merge": { "floors": [ { "rect": [0, 0, 9], "floor": "path" } ] }, "expect": ["floors[0].rect must be [x0, z0, x1, z1]"] },
    { "name": "floor rect non-integer", "merge": { "floors": [ { "rect": [0, 0, 9, 9.5], "floor": "path" } ] }, "expect": ["floors[0].rect must be [x0, z0, x1, z1]"] },
    { "name": "floor rect corner order", "merge": { "floors": [ { "rect": [9, 0, 0, 9], "floor": "path" } ] }, "expect": ["first corner must be south-west"] },
    { "name": "floor rect outside", "merge": { "floors": [ { "rect": [0, 0, 50, 9], "floor": "path" } ] }, "expect": ["floors[0].rect is outside 0..49"] },
    { "name": "detail floor unknown", "merge": { "detail": [ { "rect": [0, 0, 1, 1], "floor": "x" } ] }, "expect": ["detail[0].floor: unknown floor 'x'"] },
    { "name": "room needs a name", "merge": { "rooms": [ { "rect": [20, 20, 30, 30], "floor": "in", "wall": "w", "doors": [] } ] }, "expect": ["rooms[0]: name is required"] },
    { "name": "room needs a wall", "merge": { "rooms": [ { "name": "A", "rect": [20, 20, 30, 30], "floor": "in", "doors": [] } ] }, "expect": ["rooms[0]: wall is required"] },
    { "name": "door unknown side", "merge": { "rooms": [ { "name": "A", "rect": [20, 20, 30, 30], "floor": "in", "wall": "w", "doors": [ { "side": "up", "from": 24, "to": 26 } ] } ] }, "expect": ["rooms[0].doors[0]: unknown side 'up'"] },
    { "name": "door on the corner", "merge": { "rooms": [ { "name": "A", "rect": [20, 20, 30, 30], "floor": "in", "wall": "w", "doors": [ { "side": "west", "from": 20, "to": 22 } ] } ] }, "expect": ["from/to must sit within 21..29 on the West wall"] },
    { "name": "door reversed", "merge": { "rooms": [ { "name": "A", "rect": [20, 20, 30, 30], "floor": "in", "wall": "w", "doors": [ { "side": "north", "from": 26, "to": 24 } ] } ] }, "expect": ["from/to must sit within 21..29 on the North wall"] },
    { "name": "rooms overlap", "merge": { "rooms": [
        { "name": "A", "rect": [20, 20, 30, 30], "floor": "in", "wall": "w", "doors": [] },
        { "name": "B", "rect": [30, 30, 40, 40], "floor": "in", "wall": "w", "doors": [] } ] }, "expect": ["rooms 'A' and 'B' overlap"] },
    { "name": "rooms touching without overlap are fine", "merge": { "rooms": [
        { "name": "A", "rect": [20, 20, 30, 30], "floor": "in", "wall": "w", "doors": [] },
        { "name": "B", "rect": [31, 20, 40, 30], "floor": "in", "wall": "w", "doors": [] } ] }, "expect": [] },
    { "name": "wall run not straight", "merge": { "walls": [ { "loc": "w", "line": [1, 1, 5, 5], "angle": "north" } ] }, "expect": ["walls[0]: line is not straight"] },
    { "name": "wall run bad angle", "merge": { "walls": [ { "loc": "w", "line": [1, 1, 5, 1], "angle": "up" } ] }, "expect": ["walls[0].angle: unknown angle 'up'"] },
    { "name": "wall run needs a loc", "merge": { "walls": [ { "line": [1, 1, 5, 1], "angle": "north" } ] }, "expect": ["walls[0]: loc is required"] },
    { "name": "wall run angle is case-insensitive", "merge": { "walls": [ { "loc": "w", "line": [1, 1, 5, 1], "angle": "North" } ] }, "expect": [] },
    { "name": "loc unknown shape", "merge": { "locs": [ { "loc": "x", "x": 1, "z": 1, "shape": "Blob", "angle": "north" } ] }, "expect": ["locs[0]: unknown shape 'Blob'"] },
    { "name": "loc shape is case-insensitive", "merge": { "locs": [ { "loc": "x", "x": 1, "z": 1, "shape": "centrepiecestraight", "angle": "north" } ] }, "expect": [] },
    { "name": "loc out of bounds", "merge": { "locs": [ { "loc": "x", "x": 50, "z": 1, "shape": "WallStraight", "angle": "north" } ] }, "expect": ["locs[0].x must be 0..49"] },
    { "name": "npc needs a name", "merge": { "npcs": [ { "x": 1, "z": 1 } ] }, "expect": ["npcs[0]: npc is required"] },
    { "name": "npc coordinate must be an integer", "merge": { "npcs": [ { "npc": "zeke", "x": "1", "z": 1 } ] }, "expect": ["npcs[0].x must be 0..49"] },
    { "name": "npc in a room wall", "merge": { "npcs": [ { "npc": "zeke", "x": 20, "z": 22 } ] }, "expect": ["npc zeke at 20,22 is inside a wall"] },
    { "name": "npc in a doorway is fine", "merge": { "npcs": [ { "npc": "zeke", "x": 20, "z": 25 } ] }, "expect": [] },
    { "name": "npc on a wall run", "merge": { "walls": [ { "loc": "w", "line": [25, 20, 25, 28], "angle": "west" } ] }, "expect": ["npc zeke at 25,25 is inside a wall"] },
    { "name": "arrival in a wall", "merge": { "arrival": { "x": 30, "z": 30 } }, "expect": ["arrival is inside a wall"] },
    { "name": "arrival outside", "merge": { "arrival": { "x": 5, "z": 60 } }, "expect": ["arrival.z must be 0..49"] },
    { "name": "leave portal missing", "merge": { "leavePortal": null }, "expect": ["leavePortal.x must be 0..49", "leavePortal.z must be 0..49"] },
    { "name": "version true is not 1", "merge": { "version": true }, "expect": ["version must be 1"] },
    { "name": "size as a string", "merge": { "size": "50" }, "expect": ["size must be 8..128"] },
    { "name": "palette id true", "merge": { "palette": { "g": true, "path": 2, "in": 3 } }, "expect": ["palette.g must be 0..173"] },
    { "name": "palette id decimal", "merge": { "palette": { "g": 1.5, "path": 2, "in": 3 } }, "expect": ["palette.g must be 0..173"] },
    { "name": "door from decimal", "merge": { "rooms": [ { "name": "A", "rect": [20, 20, 30, 30], "floor": "in", "wall": "w", "doors": [ { "side": "west", "from": 24.5, "to": 26 } ] } ] }, "expect": ["from/to must sit within 21..29 on the West wall"] },
    { "name": "several problems at once", "merge": { "version": 3, "ground": "lava", "arrival": { "x": -1, "z": 5 } }, "expect": ["version must be 1", "ground: unknown floor 'lava'", "arrival.x must be 0..49"] }
  ]
}
